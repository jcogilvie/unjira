# Copy to .env (gitignored) and fill in. Real environment variables win over
# this file, so you can override a single value for one command without editing
# here. Loaded by internal/envfile, which walks up to the repository root — so
# it is found no matter which directory you run from (`go test` runs with the
# package directory as its working directory, not the repo root).
#
# Single-quote any value containing double quotes. Sourcing this file by hand
# (`set -a && . ./.env && set +a`) makes the shell strip unquoted `"`, which
# turns the JSON below into {dev:{...}} and fails to parse.
#
# UNJIRA_JIRA_CREDENTIALS is a JSON object mapping each unjira.config.json
# jira[].name to its {email, token} pair — one var regardless of how many Jira
# connections are configured, rather than a new pair of vars per connection.
# The token is an Atlassian API token:
# https://id.atlassian.com/manage-profile/security/api-tokens
UNJIRA_JIRA_CREDENTIALS='{"dev":{"email":"bot@example.com","token":"your-atlassian-api-token"}}'

# Which site and project the live integration tier (internal/live) targets. It
# reads the same UNJIRA_JIRA_CREDENTIALS above, keyed by connection name, so
# there is one credential form across the whole codebase.
#
# Defaults if unset: https://unjira.atlassian.net and project SCRUM. Set both
# when pointing at any other instance, or the tests will target the wrong place.
UNJIRA_JIRA_SITE=https://unjira.atlassian.net
UNJIRA_LIVE_PROJECT=SCRUM

# Deliberately absent: UNJIRA_LIVE=1.
#
# The live tests CREATE, TRANSITION, COMMENT ON, and DELETE real issues. Since
# .env is loaded automatically, that flag is the only thing standing between a
# stale .env and real writes to Jira, so it stays an explicit per-invocation
# choice:
#
#   UNJIRA_LIVE=1 go test -tags=live ./internal/live/...

# Optional: the LLM key the correlator uses. See config/unjira.example.json for
# the non-secret llm block (base_url, model, context window).
# UNJIRA_LLM_API_KEY=sk-...

# If your gateway issues SHORT-LIVED tokens (an OIDC/SSO-fronted proxy, say),
# leave the variable above unset and set llm.api_key_helper in
# unjira.config.json instead — a command whose stdout is the credential:
#
#   "llm": { "api_key_helper": "~/.local/bin/get-litellm-key" }
#
# unjira re-runs it as the token nears expiry, and again if the gateway answers
# 401. A key pasted here is read once and can never be refreshed, so a long pass
# dies partway through — after the earlier stages have already been paid for.
# The helper is a path, not a secret, which is why it belongs in config while the
# credential itself never does.
