# Copy to .env (gitignored) and fill in. Real environment variables win over
# this file.
#
# UNJIRA_JIRA_CREDENTIALS is a JSON object mapping each unjira.config.json
# jira[].name to its {email, token} pair — one var regardless of how many
# Jira connections are configured. The live integration test tier
# (internal/live) is unrelated and still reads its own bare
# UNJIRA_JIRA_EMAIL/UNJIRA_JIRA_TOKEN — see .github/workflows/ci.yml.
UNJIRA_JIRA_CREDENTIALS={"default":{"email":"bot@example.com","token":"your-atlassian-api-token"}}
