{
  "jira": [
    {
      "name": "default",
      "site": "https://yourorg.atlassian.net",
      "project_keys": [
        "PROJ"
      ],
      "max_issues_per_query": 200,
      "queries": [
        {
          "name": "mine-or-unassigned",
          "jql": "updated >= -14d AND (assignee = currentUser() OR reporter = currentUser() OR assignee IS EMPTY)"
        }
      ]
    }
  ],
  "collectors": {
    "claude_code": {
      "enabled": true,
      "backfill_days": 14,
      "exclude_cwds": [
        "~/workspace/unjira"
      ]
    },
    "github": {
      "enabled": false,
      "repos": [
        "yourorg/yourrepo"
      ]
    },
    "slack": {
      "enabled": false,
      "channels": [
        "#my-team"
      ]
    },
    "jira": {
      "enabled": false
    }
  },
  "exclude_from_linking": [
    "-0$",
    "-1$"
  ],
  "tracker": {
    "backend": "jira",
    "default_project": "PROJ"
  },
  "llm": {
    "model": "claude-sonnet-5",
    "base_url": "http://localhost:4000/v1",
    "context_window_tokens": 200000,
    "max_output_tokens": 32000
  },
  "correlator": {
    "tail_summarize_threshold_tokens": 6000,
    "recent_events_kept": 20,
    "max_event_summary_chars": 0
  },
  "match": {
    "max_candidates_per_narrative": 10,
    "max_narratives_per_pass": 20,
    "confidence_floor": 0.7
  },
  "reconciler": {
    "max_narratives_per_pass": 20,
    "min_confidence_to_propose": 0.5
  },
  "workflow": {
    "cache_ttl": "24h"
  },
  "rules": {
    "dir": "rules"
  },
  "db_path": "data/unjira.db"
}
