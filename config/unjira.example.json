{
  "jira": [
    {
      "name": "default",
      "site": "https://yourorg.atlassian.net",
      "project_keys": ["PROJ"]
    }
  ],
  "collectors": {
    "claude_code": {
      "enabled": true,
      "backfill_days": 14
    },
    "github": {
      "enabled": false,
      "repos": ["yourorg/yourrepo"]
    },
    "slack": {
      "enabled": false,
      "channels": ["#my-team"]
    },
    "jira": {
      "enabled": false
    }
  },
  "exclude_from_linking": ["-0$", "-1$"],
  "tracker": {
    "backend": "jira",
    "default_project": "PROJ"
  },
  "db_path": "data/unjira.db"
}
